<mxfile host="app.diagrams.net">
  <diagram name="Discrimination DAG" id="discrimination-dag">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="520" pageHeight="330">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="node-gender" value="Gender&#xa;(D)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#87CEEB;strokeColor=#333333;strokeWidth=2;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="35" y="90" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node-occupation" value="Occupation&#xa;(M)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#98FB98;strokeColor=#333333;strokeWidth=2;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="180" y="90" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node-wages" value="Wages&#xa;(Y)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#87CEEB;strokeColor=#333333;strokeWidth=2;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="325" y="90" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="edge-GO" style="strokeWidth=2;strokeColor=#333333;endArrow=classic;endFill=1" edge="1" parent="1" source="node-gender" target="node-occupation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-OW" style="strokeWidth=2;strokeColor=#333333;endArrow=classic;endFill=1" edge="1" parent="1" source="node-occupation" target="node-wages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-GW" style="strokeWidth=2;strokeColor=#333333;endArrow=classic;endFill=1;curved=1" edge="1" parent="1" source="node-gender" target="node-wages">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="30"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="node-ability" value="Ability&#xa;(A)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D3D3D3;strokeColor=#333333;strokeWidth=2;dashed=1;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="252" y="190" width="90" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="edge-AO" style="strokeWidth=2;strokeColor=#333333;endArrow=classic;endFill=1" edge="1" parent="1" source="node-ability" target="node-occupation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-AW" style="strokeWidth=2;strokeColor=#333333;endArrow=classic;endFill=1" edge="1" parent="1" source="node-ability" target="node-wages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="M is a mediator on D → M → Y and a collider on D → M ← A → Y" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="10" y="290" width="430" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
